load("re.star", "re")
load("any.star", "any")
load("terraform.proto", TerraformProto="Terraform")
load("//protoconf_terraform/config/v1/config.proto", "SubscriptionConfig")
load("//google/protobuf/struct.proto", "Struct", "Value", "ListValue")

def Chain(msg, *hooks):
    """
    Run a sequence of hooks against msg.

    Each hook has signature (msg, next) and either returns next(msg) to
    continue, or returns its own value to terminate the chain. An empty
    hooks list is valid and returns msg unchanged.
    """
    queue = list(hooks)

    def run_next(c):
        if not queue:
            return c
        nxt = queue.pop(0)
        return nxt(c, run_next)

    return run_next(msg)


def Terraform(*hooks):
    return Chain(TerraformProto(), *hooks)


def From(tf):
    def do(_, next):
        return next(tf)

    return do


def Provider(provider):
    def do(tf, next):
        if not tf.provider:
            tf.provider = TerraformProto.Providers()
        if not tf.terraform:
            tf.terraform = TerraformProto.TerraformSettings()

        provider_name = str(provider).split(".")[1]
        providerlist = getattr(tf.provider, provider_name)
        providerlist.append(provider)
        tf.terraform.required_providers[provider_name] = TerraformProto.TerraformSettings.Provider(
            source = provider.provider_fqdn,
            version = provider.provider_version
        )
        return next(tf)

    return do


_match_first_cap = re.compile("(.)([A-Z][a-z]+)")
_match_all_cap = re.compile("([a-z0-9])([A-Z])")


def _to_snake_case(s):
    s = _match_first_cap.sub("${1}_${2}", s)
    s = _match_all_cap.sub("${1}_${2}", s)
    return s.lower()


def _resource_type(resource):
    return _to_snake_case(str(resource).split()[0].split(".")[-1])


def _link(name, resource, var=False, is_data=False):
    prefix = ".".join([_resource_type(resource), name])
    if is_data:
        prefix = ".".join(["data", prefix])
    return module(
        prefix,
        self=prefix,
        **dict(
            [
                (
                    field,
                    ".".join([prefix, field])
                    if not var
                    else "${%s}" % ".".join([prefix, field]),
                )
                for field in dir(resource)
            ]
        )
    )


def _flatten(x):
    result = []
    for el in x:
        if type(el) == "list":
            result.extend(_flatten(el))
        else:
            result.append(el)
    return result


# _add_resource powers Resource() and Data(). The two differ only in which
# container they populate (tf.resource vs tf.data), the constructor for that
# container, and whether the link prefix gets a "data." segment.
#
# *link_consumers is variadic; each element is `lambda link_obj: hook` — a
# callable that receives the resource's link view and returns one or more
# real (msg, next) hooks to splice back into the chain. Returning a list (or
# nested list) is fine; flatten() unwraps it.
def _add_resource(name, resource, link_consumers, container_attr, container_ctor, is_data):
    def do(tf, next):
        if not getattr(tf, container_attr):
            setattr(tf, container_attr, container_ctor())
        bucket = getattr(getattr(tf, container_attr), _resource_type(resource))
        bucket[name] = resource
        ref = _link(name, resource, var=True, is_data=is_data)
        sub = _flatten([consumer(ref) for consumer in link_consumers])
        return next(Chain(tf, *sub))

    return do


def Resource(name, resource, *link_consumers):
    return _add_resource(
        name, resource, link_consumers,
        container_attr="resource",
        container_ctor=TerraformProto.Resources,
        is_data=False,
    )


def Data(name, datasource, *link_consumers):
    return _add_resource(
        name, datasource, link_consumers,
        container_attr="data",
        container_ctor=TerraformProto.Datasources,
        is_data=True,
    )


def Group(*hooks):
    def do(tf, next):
        return next(Chain(tf, *hooks))

    return do


def Walk(component, func):
    func(component)
    for dep in component.upstreams:
        Walk(dep, func)


def GenerateTerraformConfigs(
    prefix, state, outputs, subscription_config_key_name="watch"
):
    subscription_config = SubscriptionConfig(keys=[])

    def extract_config(component):
        for config_name, config in component.configs.items():
            if config.type_url == "type.googleapis.com/terraform.v1.Terraform":
                unpackedConfig = any.unpack(config, TerraformProto())

                # fixes a bug in any.pack which duplicates entries in repeated providers
                for providerType in dir(unpackedConfig.provider):
                    p = getattr(unpackedConfig.provider, providerType)
                    if p:
                        unpackedConfig.provider[providerType] = list(set(p))

                key = "/".join([prefix, component.domain, component.name, config_name])
                outputs[key] = unpackedConfig
                subscription_config.keys.append(key)

    for domain in state.domains.values():
        Walk(domain.head, extract_config)

    outputs[subscription_config_key_name] = subscription_config
    return outputs


def Output(k, v):
    def do(tf, next):
        tf.output[k] = TerraformProto.Output(value=v)
        return next(tf)

    return do


def _to_struct(d):
    """Build a google.protobuf.Struct from a Starlark dict."""
    return Struct(fields=dict([(k, to_value(vv)) for k, vv in d.items()]))


def to_value(v):
    """
    Convert a Starlark scalar / list / dict to a google.protobuf.Value.

    Named to_value (not `value`) so it does not shadow the imported Value
    WKT type. Dicts become Value(struct_value=Struct(...)), so nested
    lists-of-dicts round-trip correctly. None becomes Value(null_value=...).

    Args:
        v: a Starlark value (string, int, float, bool, None, list, dict)
    Returns:
        Value
    """
    if v == None:
        return Value(null_value=0)
    if type(v) == "string":
        return Value(string_value=v)
    if type(v) == "int":
        return Value(number_value=float(v))
    if type(v) == "float":
        return Value(number_value=v)
    if type(v) == "bool":
        return Value(bool_value=v)
    if type(v) == "list":
        return Value(list_value=ListValue(values=[to_value(i) for i in v]))
    if type(v) == "dict":
        return Value(struct_value=_to_struct(v))
    fail("to_value(): unsupported type %s for %r" % (type(v), v))


def Module(name, source, then=(), **kwargs):
    def do(tf, next):
        kwargs["source"] = source
        tf.module[name] = _to_struct(kwargs)
        outputs = lambda key: "${module.%s.%s}" % (name, key)
        return next(Chain(tf, *[child(outputs) for child in then]))

    return do


util = module(
    "Terraform",
    Terraform=Terraform,
    Provider=Provider,
    Resource=Resource,
    Data=Data,
    Output=Output,
    Group=Group,
    Module=Module,
)
